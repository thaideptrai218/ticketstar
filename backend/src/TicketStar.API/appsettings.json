{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MySqlConnection": "Server=localhost;Port=3307;Database=ticketstar;User=root;Password=${MYSQL_ROOT_PASSWORD};",
    "RedisConnection": "localhost:6380,password=${REDIS_PASSWORD}"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest"
  },
  "Jwt": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "TicketStar",
    "Audience": "TicketStar",
    "ExpiryMinutes": 15
  },
  "Google": {
    "ClientId": "${GOOGLE_CLIENT_ID}"
  },
  "Redis": {
    "ConnectionString": "localhost:6380,password=${REDIS_PASSWORD}"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3001"]
  },
  "Mfa": {
    "EncryptionKey": "${MFA_ENCRYPTION_KEY}",
    "Issuer": "TicketStar"
  },
  "Qr": {
    "HmacSecret": "${QR_HMAC_SECRET}",
    "QrCodeSize": 300,
    "QrExpiryHoursAfterEventStart": 24
  },
  "SePay": {
    "ApiKey": "${SEPAY_API_KEY}",
    "SecretKey": "${SEPAY_SECRET_KEY}",
    "WebhookPath": "/api/webhooks/sepay",
    "UseMock": true
  },
  "Admin": {
    "Email": "admin@ticketstar.dev",
    "Password": "${ADMIN_PASSWORD}"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5010"
      }
    }
  }
}
