{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MySqlConnection": "Server=localhost;Port=3307;Database=ticketstar;User=root;Password=${MYSQL_ROOT_PASSWORD};",
    "RedisConnection": "localhost:6380,password=${REDIS_PASSWORD}"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest"
  },
  "Jwt": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "TicketStar",
    "Audience": "TicketStar",
    "ExpiryMinutes": 60
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5010"
      }
    }
  }
}
