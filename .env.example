# Docker infrastructure secrets
MYSQL_ROOT_PASSWORD=root1234
MYSQL_DATABASE=ticketstar
REDIS_PASSWORD=root1234
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# MassTransit license (empty for development, see https://masstransit.io/license)
MT_LICENSE=

# JWT configuration
JWT_SECRET=dev-secret-min-256-bit-change-in-production-!!

# MFA encryption key (32-byte base64: openssl rand -base64 32)
MFA_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes

# QR code HMAC secret (256-bit for QR signature)
QR_HMAC_SECRET=CHANGE_ME_qr_hmac_secret_min_32_bytes

# SePay configuration (mock mode enabled for development)
SEPAY_API_KEY=your-sepay-api-key
SEPAY_SECRET_KEY=your-sepay-secret-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:5010

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=TicketStar
